{
  "$id": "urn:fairmark:schema:coc.cost_of_debt:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Input of `coc.cost_of_debt`.",
  "properties": {
    "credit_spread": {
      "description": "Credit spread over the risk-free rate, annual decimal fraction (with `risk_free_rate`).",
      "pattern": "^-?\\d+(\\.\\d+)?([eE]\\d+)?$",
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "pre_tax_cost_of_debt": {
      "description": "Pre-tax cost of debt, annual decimal fraction. Give either this, or `risk_free_rate`\nand `credit_spread`.",
      "pattern": "^-?\\d+(\\.\\d+)?([eE]\\d+)?$",
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "risk_free_rate": {
      "description": "Risk-free rate, annual decimal fraction (with `credit_spread`).",
      "pattern": "^-?\\d+(\\.\\d+)?([eE]\\d+)?$",
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "tax_rate": {
      "description": "Tax rate of the tax shield, decimal fraction from 0 to below 1.",
      "pattern": "^-?\\d+(\\.\\d+)?([eE]\\d+)?$",
      "type": [
        "string",
        "number"
      ]
    }
  },
  "required": [
    "tax_rate"
  ],
  "title": "CostOfDebtInput",
  "type": "object",
  "x-fairmark-method": "coc.cost_of_debt",
  "x-fairmark-method-version": "1"
}
