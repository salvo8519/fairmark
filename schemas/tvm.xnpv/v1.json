{
  "$defs": {
    "Compounding": {
      "description": "How often interest is compounded within a year.",
      "oneOf": [
        {
          "const": "annual",
          "description": "Once a year: the rate is an effective annual rate.",
          "type": "string"
        },
        {
          "const": "semi_annual",
          "description": "Twice a year (nominal rate / 2 per half year).",
          "type": "string"
        },
        {
          "const": "quarterly",
          "description": "Four times a year.",
          "type": "string"
        },
        {
          "const": "monthly",
          "description": "Twelve times a year.",
          "type": "string"
        },
        {
          "const": "continuous",
          "description": "Continuously: growth factor e^(r t).",
          "type": "string"
        }
      ]
    },
    "Date": {
      "description": "Calendar date, ISO 8601 YYYY-MM-DD, from 1900-01-01 to 2199-12-31.",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    },
    "DatedCashFlow": {
      "additionalProperties": false,
      "description": "An amount paid or received on a date.",
      "properties": {
        "amount": {
          "description": "Amount in currency units; negative for payments, positive for receipts.",
          "pattern": "^-?\\d+(\\.\\d+)?([eE]\\d+)?$",
          "type": [
            "string",
            "number"
          ]
        },
        "date": {
          "$ref": "#/$defs/Date",
          "description": "Date of the flow (ISO 8601)."
        }
      },
      "required": [
        "date",
        "amount"
      ],
      "type": "object"
    },
    "DayCount": {
      "description": "Day-count conventions of the 2006 ISDA Definitions, section 4.16.",
      "oneOf": [
        {
          "const": "act_365_fixed",
          "description": "Actual/365 (Fixed), §4.16(d): actual days / 365.",
          "type": "string"
        },
        {
          "const": "act_360",
          "description": "Actual/360, §4.16(e): actual days / 360.",
          "type": "string"
        },
        {
          "const": "act_act_isda",
          "description": "Actual/Actual (ISDA), §4.16(b): days in leap years / 366 + other days / 365.",
          "type": "string"
        },
        {
          "const": "thirty_360",
          "description": "30/360 (Bond Basis), §4.16(f): day 31 becomes 30; the end day 31 becomes 30 only if the\nstart day is 30 or 31.",
          "type": "string"
        },
        {
          "const": "thirty_e_360",
          "description": "30E/360 (Eurobond Basis), §4.16(g): every day 31 becomes 30.",
          "type": "string"
        }
      ]
    }
  },
  "$id": "urn:fairmark:schema:tvm.xnpv:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Input of `tvm.xnpv`.",
  "properties": {
    "cash_flows": {
      "description": "Dated cash flows, in any order.",
      "items": {
        "$ref": "#/$defs/DatedCashFlow"
      },
      "type": "array"
    },
    "compounding": {
      "anyOf": [
        {
          "$ref": "#/$defs/Compounding"
        },
        {
          "type": "null"
        }
      ],
      "description": "Compounding of `rate`. Default: `annual` (ECMA-376 XNPV)."
    },
    "day_count": {
      "anyOf": [
        {
          "$ref": "#/$defs/DayCount"
        },
        {
          "type": "null"
        }
      ],
      "description": "Day count for the time between dates. Default: `act_365_fixed` (ECMA-376 XNPV)."
    },
    "rate": {
      "description": "Annual discount rate, decimal fraction (0.09 = 9%), quoted with `compounding`.",
      "pattern": "^-?\\d+(\\.\\d+)?([eE]\\d+)?$",
      "type": [
        "string",
        "number"
      ]
    },
    "valuation_date": {
      "anyOf": [
        {
          "$ref": "#/$defs/Date"
        },
        {
          "type": "null"
        }
      ],
      "description": "Date at which the value is computed. Default: the earliest flow date (ECMA-376 XNPV)."
    }
  },
  "required": [
    "rate",
    "cash_flows"
  ],
  "title": "XnpvInput",
  "type": "object",
  "x-fairmark-method": "tvm.xnpv",
  "x-fairmark-method-version": "1"
}
