{
  "$defs": {
    "AnnuityTiming": {
      "description": "When the payments of an annuity or perpetuity occur.",
      "oneOf": [
        {
          "const": "ordinary",
          "description": "Payments at the end of each period (first payment at t = 1).",
          "type": "string"
        },
        {
          "const": "due",
          "description": "Payments at the beginning of each period (first payment at t = 0).",
          "type": "string"
        }
      ]
    },
    "Compounding": {
      "description": "How often interest is compounded within a year.",
      "oneOf": [
        {
          "const": "annual",
          "description": "Once a year: the rate is an effective annual rate.",
          "type": "string"
        },
        {
          "const": "semi_annual",
          "description": "Twice a year (nominal rate / 2 per half year).",
          "type": "string"
        },
        {
          "const": "quarterly",
          "description": "Four times a year.",
          "type": "string"
        },
        {
          "const": "monthly",
          "description": "Twelve times a year.",
          "type": "string"
        },
        {
          "const": "continuous",
          "description": "Continuously: growth factor e^(r t).",
          "type": "string"
        }
      ]
    },
    "PaymentFrequency": {
      "description": "How often instalments are paid.",
      "oneOf": [
        {
          "const": "annual",
          "description": "One instalment a year.",
          "type": "string"
        },
        {
          "const": "semi_annual",
          "description": "Two instalments a year.",
          "type": "string"
        },
        {
          "const": "quarterly",
          "description": "Four instalments a year.",
          "type": "string"
        },
        {
          "const": "monthly",
          "description": "Twelve instalments a year.",
          "type": "string"
        }
      ]
    }
  },
  "$id": "urn:fairmark:schema:loans.number_of_instalments:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Input of `loans.number_of_instalments`.",
  "properties": {
    "compounding": {
      "anyOf": [
        {
          "$ref": "#/$defs/Compounding"
        },
        {
          "type": "null"
        }
      ],
      "description": "Compounding of `rate` (form a); required with `rate`, no default."
    },
    "instalment": {
      "description": "Constant instalment, in currency units; it must exceed the interest of the first period.",
      "pattern": "^-?\\d+(\\.\\d+)?([eE]\\d+)?$",
      "type": [
        "string",
        "number"
      ]
    },
    "payment_frequency": {
      "anyOf": [
        {
          "$ref": "#/$defs/PaymentFrequency"
        },
        {
          "type": "null"
        }
      ],
      "description": "Instalments per year (form a): `annual`, `semi_annual`, `quarterly` or `monthly`."
    },
    "periodic_rate": {
      "description": "Rate per payment period, decimal fraction (form b), greater than -1; instead of `rate`,\n`compounding` and `payment_frequency`.",
      "pattern": "^-?\\d+(\\.\\d+)?([eE]\\d+)?$",
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "principal": {
      "description": "Amount borrowed, in currency units, greater than zero.",
      "pattern": "^-?\\d+(\\.\\d+)?([eE]\\d+)?$",
      "type": [
        "string",
        "number"
      ]
    },
    "rate": {
      "description": "Annual borrowing rate, decimal fraction (0.05 = 5% a year), quoted with `compounding`.\nRate form (a): give it with `compounding` and `payment_frequency`, or give\n`periodic_rate` instead.",
      "pattern": "^-?\\d+(\\.\\d+)?([eE]\\d+)?$",
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "timing": {
      "$ref": "#/$defs/AnnuityTiming",
      "description": "`ordinary` (in arrears: instalment k at the end of period k) or `due` (in advance: at the\nbeginning of period k)."
    }
  },
  "required": [
    "principal",
    "instalment",
    "timing"
  ],
  "title": "NumberOfInstalmentsInput",
  "type": "object",
  "x-fairmark-method": "loans.number_of_instalments",
  "x-fairmark-method-version": "1"
}
