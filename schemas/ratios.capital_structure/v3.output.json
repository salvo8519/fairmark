{
  "$defs": {
    "RatioValue": {
      "description": "A ratio (SPEC-0007 R3, R7). When it is not defined or not computed, its value is null and\nthe reason is an entry of `diagnostics.not_computed` at the ratio's pointer (SPEC-0012 R6).",
      "properties": {
        "value": {
          "description": "The ratio, in the unit stated by the field that holds it (decimal fraction, multiple or\ndays); null when the ratio is not defined or not computed (see\n`diagnostics.not_computed`).",
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "value"
      ],
      "type": "object"
    }
  },
  "$id": "urn:fairmark:schema:ratios.capital_structure:v3:output",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Output of `ratios.capital_structure`.",
  "properties": {
    "debt_to_equity": {
      "$ref": "#/$defs/RatioValue",
      "description": "Gross debt / equity, multiple."
    },
    "equity_ratio": {
      "$ref": "#/$defs/RatioValue",
      "description": "Equity / total assets, decimal fraction."
    },
    "net_financial_position": {
      "description": "Net financial position used by the ratios, in currency units (positive for net debt);\nnull when not computed.",
      "pattern": "^-?\\d+(\\.\\d+)?$",
      "type": [
        "string",
        "null"
      ]
    },
    "nfp_to_equity": {
      "$ref": "#/$defs/RatioValue",
      "description": "Net financial position / equity, multiple."
    },
    "primary_fixed_asset_coverage": {
      "$ref": "#/$defs/RatioValue",
      "description": "Equity / fixed assets, multiple."
    },
    "primary_structure_margin": {
      "description": "Equity − fixed assets, in currency units; null when not computed.",
      "pattern": "^-?\\d+(\\.\\d+)?$",
      "type": [
        "string",
        "null"
      ]
    },
    "secondary_fixed_asset_coverage": {
      "$ref": "#/$defs/RatioValue",
      "description": "(Equity + non-current liabilities) / fixed assets, multiple."
    },
    "secondary_structure_margin": {
      "description": "Equity + non-current liabilities − fixed assets, in currency units; null when not\ncomputed.",
      "pattern": "^-?\\d+(\\.\\d+)?$",
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "net_financial_position",
    "debt_to_equity",
    "nfp_to_equity",
    "equity_ratio",
    "primary_structure_margin",
    "secondary_structure_margin",
    "primary_fixed_asset_coverage",
    "secondary_fixed_asset_coverage"
  ],
  "title": "CapitalStructureOutput",
  "type": "object",
  "x-fairmark-method": "ratios.capital_structure",
  "x-fairmark-method-version": "3"
}
