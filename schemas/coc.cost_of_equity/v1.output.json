{
  "$id": "urn:fairmark:schema:coc.cost_of_equity:v1:output",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Output of `coc.cost_of_equity`.",
  "properties": {
    "cost_of_equity": {
      "description": "Cost of equity, annual decimal fraction.",
      "pattern": "^-?\\d+(\\.\\d+)?$",
