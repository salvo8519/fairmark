{
  "$defs": {
    "Date": {
      "description": "Calendar date, ISO 8601 YYYY-MM-DD, from 1900-01-01 to 2199-12-31.",
      "format": "date",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$",
      "type": "string"
    },
    "DayCount": {
      "description": "Day-count conventions of the 2006 ISDA Definitions, section 4.16.",
      "oneOf": [
        {
          "const": "act_365_fixed",
          "description": "Actual/365 (Fixed), §4.16(d): actual days / 365.",
          "type": "string"
        },
        {
          "const": "act_360",
          "description": "Actual/360, §4.16(e): actual days / 360.",
          "type": "string"
        },
        {
          "const": "act_act_isda",
          "description": "Actual/Actual (ISDA), §4.16(b): days in leap years / 366 + other days / 365.",
          "type": "string"
        },
        {
          "const": "thirty_360",
          "description": "30/360 (Bond Basis), §4.16(f): day 31 becomes 30; the end day 31 becomes 30 only if the\nstart day is 30 or 31.",
          "type": "string"
        },
        {
          "const": "thirty_e_360",
          "description": "30E/360 (Eurobond Basis), §4.16(g): every day 31 becomes 30.",
          "type": "string"
        }
      ]
    }
  },
  "$id": "urn:fairmark:schema:dates.year_fraction:v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Input of `dates.year_fraction`.",
  "properties": {
    "day_count": {
      "$ref": "#/$defs/DayCount",
      "description": "Day-count convention."
    },
    "end": {
      "$ref": "#/$defs/Date",
      "description": "End date (ISO 8601), not earlier than the start date."
    },
    "start": {
      "$ref": "#/$defs/Date",
      "description": "Start date (ISO 8601)."
    }
  },
  "required": [
    "start",
    "end",
    "day_count"
  ],
  "title": "YearFractionInput",
  "type": "object",
  "x-fairmark-method": "dates.year_fraction",
  "x-fairmark-method-version": "1"
}
