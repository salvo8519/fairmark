{
  "$defs": {
    "RatioValue": {
      "description": "A ratio, or the reason it is not defined (SPEC-0007 R3).",
      "properties": {
        "not_defined": {
          "description": "Why the ratio is not defined, for example \"equity is negative (-100)\"; null when it is\ndefined.",
          "type": [
            "string",
            "null"
          ]
        },
        "value": {
          "description": "The ratio, in the unit stated by the field that holds it (decimal fraction, multiple or\ndays); null when the ratio is not defined.",
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "value",
        "not_defined"
      ],
      "type": "object"
    }
  },
  "$id": "urn:fairmark:schema:ratios.working_capital:v1:output",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Output of `ratios.working_capital`, in days.",
  "properties": {
    "cash_conversion_cycle": {
      "$ref": "#/$defs/RatioValue",
      "description": "DSO + DIO − DPO, days."
    },
    "days_inventory_outstanding": {
      "$ref": "#/$defs/RatioValue",
      "description": "Inventories × days / cost of sales, days."
    },
    "days_payable_outstanding": {
      "$ref": "#/$defs/RatioValue",
      "description": "Trade payables × days / purchases, days."
    },
    "days_sales_outstanding": {
      "$ref": "#/$defs/RatioValue",
      "description": "Trade receivables × days / revenue, days."
    }
  },
  "required": [
    "days_sales_outstanding",
    "days_inventory_outstanding",
    "days_payable_outstanding",
    "cash_conversion_cycle"
  ],
  "title": "WorkingCapitalOutput",
  "type": "object",
  "x-fairmark-method": "ratios.working_capital",
  "x-fairmark-method-version": "1"
}
