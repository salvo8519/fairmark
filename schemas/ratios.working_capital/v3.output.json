{
  "$defs": {
    "RatioValue": {
      "description": "A ratio (SPEC-0007 R3, R7). When it is not defined or not computed, its value is null and\nthe reason is an entry of `diagnostics.not_computed` at the ratio's pointer (SPEC-0012 R6).",
      "properties": {
        "value": {
          "description": "The ratio, in the unit stated by the field that holds it (decimal fraction, multiple or\ndays); null when the ratio is not defined or not computed (see\n`diagnostics.not_computed`).",
          "pattern": "^-?\\d+(\\.\\d+)?$",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "value"
      ],
      "type": "object"
    }
  },
  "$id": "urn:fairmark:schema:ratios.working_capital:v3:output",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Output of `ratios.working_capital`, in days.",
  "properties": {
    "cash_conversion_cycle": {
      "$ref": "#/$defs/RatioValue",
      "description": "DSO + DIO − DPO, days."
    },
    "days_inventory_outstanding": {
      "$ref": "#/$defs/RatioValue",
      "description": "Inventories × days / cost of sales, days."
    },
    "days_payable_outstanding": {
      "$ref": "#/$defs/RatioValue",
      "description": "Trade payables × days / purchases, days."
    },
    "days_sales_outstanding": {
      "$ref": "#/$defs/RatioValue",
      "description": "Trade receivables × days / revenue, days."
    }
  },
  "required": [
    "days_sales_outstanding",
    "days_inventory_outstanding",
    "days_payable_outstanding",
    "cash_conversion_cycle"
  ],
  "title": "WorkingCapitalOutput",
  "type": "object",
  "x-fairmark-method": "ratios.working_capital",
  "x-fairmark-method-version": "3"
}
