{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Input of `tvm.npv`.",
  "properties": {
    "cash_flows": {
      "description": "Cash flows; the first one occurs at t = 0 (no discounting).",
      "items": {
        "pattern": "^-?\\d+(\\.\\d+)?([eE]\\d+)?$",
        "type": [
          "string",
          "number"
        ]
      },
      "type": "array"
    },
    "rate": {
      "description": "Discount rate per period as a decimal fraction (0.10 = 10%).",
      "pattern": "^-?\\d+(\\.\\d+)?([eE]\\d+)?$",
      "type": [
        "string",
        "number"
      ]
    }
  },
  "required": [
    "rate",
    "cash_flows"
  ],
  "title": "NpvInput",
  "type": "object"
}
