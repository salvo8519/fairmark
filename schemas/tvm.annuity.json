{
  "$defs": {
    "AnnuityTiming": {
      "description": "When the payments of an annuity or perpetuity occur.",
      "oneOf": [
        {
          "const": "ordinary",
          "description": "Payments at the end of each period (first payment at t = 1).",
          "type": "string"
        },
        {
          "const": "due",
          "description": "Payments at the beginning of each period (first payment at t = 0).",
          "type": "string"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Input of `tvm.annuity`.",
  "properties": {
    "growth": {
      "description": "Growth of the payment per period, decimal fraction. Default: 0 (level annuity).",
      "pattern": "^-?\\d+(\\.\\d+)?([eE]\\d+)?$",
      "type": [
        "string",
        "number",
        "null"
      ]
    },
    "payment": {
      "description": "First payment, in currency units.",
      "pattern": "^-?\\d+(\\.\\d+)?([eE]\\d+)?$",
      "type": [
        "string",
        "number"
      ]
    },
    "periods": {
      "description": "Number of payments, from 1 to 10000.",
      "format": "uint32",
      "minimum": 0,
      "type": "integer"
    },
    "rate": {
      "description": "Discount rate per period, decimal fraction.",
      "pattern": "^-?\\d+(\\.\\d+)?([eE]\\d+)?$",
      "type": [
        "string",
        "number"
      ]
    },
    "timing": {
      "$ref": "#/$defs/AnnuityTiming",
      "description": "`ordinary` (end of period) or `due` (beginning of period)."
    }
  },
  "required": [
    "payment",
    "rate",
    "periods",
    "timing"
  ],
  "title": "AnnuityInput",
  "type": "object"
}
